
---

## 📄 .gitignore

```gitignore
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Gradle Wrapper
!gradle/wrapper/
gradle/wrapper/gradle-wrapper.properties

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
.idea/
.classpath
.project
.settings/
bin/

# Eclipse
.metadata/
.apt_generated/
.apt_generated_tests/
.factorypath
.springBeans
.sts4-cache

# VS Code
.vscode/
*.code-workspace

# Mac OS
.DS_Store
Thumbs.db

# Application properties (se tiver dados sensíveis)
# application-local.properties
# application-dev.properties

# Node.js (se usar)
node_modules/
npm-debug.log
yarn-error.log